{
  "name": "@argon-chat/emojix",
  "version": "0.3.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./dist/emojix.cjs",
      "types": "./src/index.ts"
    },
    "./style.css": "./src/themes/variables.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "dev:playground": "vite --config playground/vite.config.ts",
    "build": "vue-tsc --noEmit && vite build && bun run build:types",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "generate:atlas": "bun run scripts/generate-atlas.ts",
    "generate:data": "bun run scripts/generate-data.ts",
    "generate": "bun run generate:atlas && bun run generate:data"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "^1.3.14",
    "@vitejs/plugin-vue": "^6.0.5",
    "emojibase": "^17.0.0",
    "emojibase-data": "^17.0.0",
    "esbuild": "^0.28.0",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.0.0",
    "vite": "^8.0.7",
    "vue": "^3.5.32",
    "vue-tsc": "^3.2.6"
  }
}
